{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bgxiong://contracts/story-skill-editorial-finding-v1",
  "title": "StorySkillEditorialFindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findingId", "rubricId", "severity", "artifactRevision", "evidenceUnitIds", "explanation", "suggestedChange", "disposition"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "findingId": { "type": "string", "minLength": 1 },
    "rubricId": {
      "enum": ["character", "causality", "relationship", "emotion", "dialogue", "payoff", "continuity", "genreFit"]
    },
    "severity": { "enum": ["blocking", "minor"] },
    "artifactRevision": { "type": "string", "minLength": 1 },
    "evidenceUnitIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "relatedFactIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "explanation": { "type": "string", "minLength": 1 },
    "suggestedChange": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["open", "resolved", "dismissed"] },
    "dispositionReason": { "type": ["string", "null"] }
  }
}
