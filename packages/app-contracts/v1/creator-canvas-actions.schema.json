                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "W5B A505: fc_service::reorder_reference_edges; compensation restores prior port order.",
            "required": [
