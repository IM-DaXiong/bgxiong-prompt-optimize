{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creator-canvas-actions.schema.json",
  "title": "CreatorCanvasActions",
  "type": "object",
  "required": [
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "actionId",
                "projectId",
                "targetNodeId",
                "expectedGraphRevision"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "group.link"
                },
                "actionId": {
                  "type": "string",
                  "minLength": 1
                },
                "projectId": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "$ref": "#/$defs/actionRef"
                    }
                  ]
                },
                "targetNodeId": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "$ref": "#/$defs/actionRef"
                    }
                  ]
                },
                "groupId": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "$ref": "#/$defs/actionRef"
                    }
                  ]
                },
                "memberIds": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "#/$defs/actionRef"
                      }
                    ]
                  },
                  "minItems": 2,
                  "uniqueItems": true
                },
                "targetPort": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "removeEdgeIds": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "#/$defs/actionRef"
                      }
                    ]
                  },
                  "uniqueItems": true
                },
                "expectedGraphRevision": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "$ref": "#/$defs/actionRef"
                    }
                  ]
                }
              },
              "oneOf": [
                {
                  "required": [
                    "groupId"
                  ],
                  "not": {
                    "required": [
                      "memberIds"
                    ]
                  }
                },
                {
                  "required": [
                    "memberIds"
                  ],
                  "not": {
                    "required": [
                      "groupId"
                    ]
                  }
                }
              ]
            },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "project.create"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "node.create"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "kind": {
                "enum": [
                  "text",
                  "image",
                  "audio",
                  "video",
                  "group"
                ]
              },
              "text": {
                "type": "string"
              },
              "placement": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "enum": [
                      "adjacent",
                      "absolute"
                    ]
                  },
                  "anchorNodeId": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "#/$defs/actionRef"
                      }
                    ]
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "o": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "fromNodeId",
              "toNodeId"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "edge.connect"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "fromNodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "toNodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "edgeIds",
              "expectedGraphRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "edge.disconnect"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "edgeIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "$ref": "#/$defs/actionRef"
                    }
                  ]
                }
              },
              "expectedGraphRevision": {
                "type": "string",
                "description": "本计划开始前读取的图版本；同一计划同一图的动作填写同一个值，Host 接力本计划产生的版本，事务内仍校验实际图。"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "nodeId",
              "promptText",
              "expectedRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "node.prompt.patch"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "nodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "promptText": {
                "type": "string"
              },
              "expectedRevision": {
                "type": "string",
                "minLength": 5,
                "pattern": "^fcn:[^\\s]+$",
                "description": "Copy the exact canvas node revision from resource.get items[].revision (or resource.editable.get promptText.revisionToken) after reading its current promptText. Never use draftRevision, selectionRevision, snapshotRevision or imageVersions.revisionToken. Re-read content after a genuine conflict; do not substitute a new token into an old edit blindly."
              }
            }
          },
          {
            "type": "object",
            "description": "Rename the free-canvas tile header. Non-group nodes store displayTitle; groups store title. Empty title clears a non-group override. Does not change promptText, media, or layout.",
            "required": [
              "type",
              "actionId",
              "projectId",
              "nodeId",
              "title",
              "expectedRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "node.title.patch"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "nodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "title": {
                "type": "string",
                "description": "Next header text. Whitespace clears displayTitle on text/image/audio/video. Group title is stored as given, including an empty string."
              },
              "expectedRevision": {
                "type": "string",
                "minLength": 5,
                "pattern": "^fcn:[^\\s]+$",
                "description": "Copy items[].revision from resource.get for this canvasNode. Same domain as node.prompt.patch. Read tileTitle before writing; a kindDefault shownText written back becomes a user title."
              }
            }
          },
          {
            "type": "object",
            "description": "Preference write for one free-canvas media node. Does not start generation. Resource CAS is expectedResourceRevision, not a UI snapshot revision. bindingId and modelId are catalog refs; Omit workflowRef or use null (both mean None) when the binding has no workflow.",
            "required": [
              "type",
              "actionId",
              "projectId",
              "nodeId",
              "capabilitySlot",
              "bindingId",
              "modelId",
              "expectedResourceRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "node.modelPick.set"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "nodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "capabilitySlot": {
                "type": "string",
                "enum": [
                  "imageT2i",
                  "imageI2i",
                  "video"
                ]
              },
              "bindingId": {
                "type": "string",
                "minLength": 1
              },
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "workflowRef": {
                "x-creator-null-semantics": "absent",
                "type": ["string", "null"],
                "minLength": 1
              },
              "expectedResourceRevision": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "nodeId"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "node.trash"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "nodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "nodeId"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "node.restore"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "nodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "nodeId"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "layout.patch"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "nodeId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/actionRef"
                  }
                ]
              },
              "clear": { "type": "boolean", "description": "Restore absence; expectedRevision required and layout fields forbidden." },
                "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              },
              "z": {
                "type": "integer"
              },
              "orderIdx": {
                "type": "integer"
              },
              "expectedRevision": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "memberIds"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "group.create"
              },
