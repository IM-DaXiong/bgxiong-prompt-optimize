                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "actionId",
              "projectId",
              "nodeId",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "node.move"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
