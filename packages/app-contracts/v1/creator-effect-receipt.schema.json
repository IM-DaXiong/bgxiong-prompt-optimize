{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creator-effect-receipt.schema.json",
  "title": "CreatorEffectReceipt",
  "description": "RC05/§3.10: canonical effect produced once by the typed receipt decoder. operationRef = one domain operation; effectId = one confirmed effect; receiptRef = durable re-readable receipt; undoRef only when really undoable. The three are never substituted for each other. observation never fabricates a mutation; taskAccepted never claims a finished result.",
  "type": "object",
  "required": ["schemaVersion", "effectId", "receiptRef", "operationRef", "effectSequence", "toolId", "actionType", "receiptKind", "outcomeState", "undoRef", "reversesEffectRef", "requestRef", "planRef", "taskRef", "resources", "scopes", "committedAtMs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "effectId": {"type": "string", "minLength": 1},
    "receiptRef": {"type": "string", "minLength": 1},
    "operationRef": {"type": "string", "minLength": 1},
    "effectSequence": {"type": "integer", "minimum": 1},
    "toolId": {"type": "string", "minLength": 1},
    "actionType": {"type": ["string", "null"]},
    "receiptKind": {"enum": ["observation", "requestControl", "sessionControl", "uiDraft", "plan", "mutation", "inverse", "planCancel", "taskAccepted", "taskControl", "fileEffect", "refreshDelivery"]},
    "outcomeState": {"enum": ["observed", "partial", "failed", "accepted", "rejected", "activated", "acknowledged", "notOpen", "prepared", "previewReady", "applied", "unknown", "undone", "cancelled", "cancelRequested", "terminal", "pending", "written", "refreshed", "pendingRefresh"]},
    "undoRef": {"type": ["string", "null"]},
    "reversesEffectRef": {"type": ["string", "null"]},
    "requestRef": {"type": ["string", "null"]},
    "planRef": {"type": ["string", "null"]},
    "taskRef": {"type": ["string", "null"]},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "change"],
        "additionalProperties": false,
        "properties": {
          "ref": {"$ref": "creator-resource-ref.schema.json"},
          "change": {"enum": ["created", "updated", "deleted", "moved", "observed"]},
          "revision": {"type": ["string", "null"]}
        }
      }
    },
    "scopes": {"type": "array", "items": {"$ref": "creator-view-refresh.schema.json#/$defs/effectScope"}},
    "resourcesPage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["nextCursor", "total"],
          "properties": {
            "nextCursor": {"type": ["string", "null"]},
            "total": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "committedAtMs": {"type": "integer", "minimum": 0}
  },
  "examples": [
