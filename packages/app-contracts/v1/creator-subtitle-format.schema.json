{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "policy"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cues"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startMs",
              "endMs",
              "text",
              "units"
            ],
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "startMs",
                    "endMs",
                    "text"
                  ],
                  "properties": {
                    "startMs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "endMs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetChars",
        "maxChars"
      ],
      "properties": {
        "targetChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "correctTypos": {
          "type": "boolean"
        }
      }
    }
  }
}
