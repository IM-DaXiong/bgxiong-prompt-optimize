                  "changeRequest"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "task": {
                    "const": "generate"
                  }
                },
                "required": [
                  "task"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "draft"
                      ]
                    },
                    {
                      "required": [
                        "changeRequest"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "IntegrationModelInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityKind",
        "existing",
        "candidates",
        "occurrences",
        "existingOccurrences",
        "extraConstraints"
      ],
      "properties": {
        "entityKind": {
          "$ref": "story-creation.schema.json#/definitions/EntityKind"
        },
        "existing": {
          "type": "array",
          "items": {
            "$ref": "story-creation.schema.json#/definitions/RegistryEntry"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Candidate"
          }
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CandidateOccurrence"
          }
        },
        "existingOccurrences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExistingOccurrence"
          }
        },
        "extraConstraints": {
          "type": "string"
        }
      }
    },
    "ExistingChapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapterId",
        "title",
        "script"
      ],
      "properties": {
        "chapterId": {
          "$ref": "story-creation.schema.json#/definitions/Id"
        },
        "title": {
          "type": "string"
        },
        "script": {
          "type": "string"
        }
      }
    },
    "ShotDialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialogueMode",
        "dialogueLines"
      ],
      "properties": {
        "dialogueMode": {
          "type": "string",
          "enum": [
            "on_screen",
            "off_screen",
            "voice_over",
            "internal_monologue",
            "silent"
          ]
        },
        "dialogueLines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speaker",
              "line"
            ],
            "properties": {
              "speaker": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "castId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "cast"
                      },
                      "castId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "entityId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "sceneEntity"
                      },
                      "entityId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "narratorId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "narrator"
                      },
                      "narratorId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "sourceUnitId",
                      "reason"
                    ],
                    "properties": {
                      "kind": {
                        "const": "unresolved"
                      },
                      "sourceUnitId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "line": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dialogueMode": {
                "const": "silent"
              }
            },
            "required": [
              "dialogueMode"
            ]
          },
          "then": {
            "properties": {
              "dialogueLines": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "dialogueLines": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
