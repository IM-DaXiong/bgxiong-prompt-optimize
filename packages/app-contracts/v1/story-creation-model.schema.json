            "existingChapters": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ExistingChapter"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "task": {
                    "const": "optimize"
                  }
                },
                "required": [
                  "task"
                ]
              },
              "then": {
                "required": [
                  "draft",
                  "changeRequest"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "task": {
                    "const": "generate"
                  }
                },
                "required": [
                  "task"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
