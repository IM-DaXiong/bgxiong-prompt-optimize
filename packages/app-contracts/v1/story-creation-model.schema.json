    "SceneDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localId",
        "title",
        "script",
        "scenePrompt",
        "storyboardHint",
        "mentions"
      ],
      "properties": {
        "localId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "scenePrompt": {
          "type": "string"
        },
        "storyboardHint": {
          "type": "string"
        },
        "mentions": {
          "$ref": "#/definitions/Mentions"
        }
      }
    },
    "ScenesReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenes",
        "candidates"
      ],
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SceneDraft"
          },
          "minItems": 1
        },
        "candidates": {
          "$ref": "#/definitions/CandidateLists"
        }
      }
    },
    "ShotDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localId",
        "title",
        "staticFramePrompt",
        "videoPrompt",
        "mentions",
        "dialogue"
      ],
      "properties": {
        "localId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "staticFramePrompt": {
          "type": "string",
          "minLength": 1
        },
        "videoPrompt": {
          "type": "string",
          "minLength": 1
        },
        "mentions": {
          "$ref": "#/definitions/Mentions"
        },
        "dialogue": {
          "$ref": "#/definitions/ShotDialogue"
        }
      }
    },
    "StoryboardReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shots",
        "candidates"
      ],
      "properties": {
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShotDraft"
          },
          "minItems": 1
        },
        "candidates": {
          "$ref": "#/definitions/CandidateLists"
        }
      }
    },
    "ExtractionReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Candidate"
          }
        }
      }
