    "EntityDecision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "candidateIds",
            "newKey",
            "name",
            "description"
          ],
          "properties": {
            "op": {
              "const": "create"
            },
            "candidateIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "newKey": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "candidateIds",
            "targetId"
          ],
          "properties": {
            "op": {
              "const": "reuse"
            },
            "candidateIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "targetId": {
              "$ref": "story-creation.schema.json#/definitions/Id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "candidateIds",
            "targetId",
            "name",
            "description"
          ],
          "properties": {
            "op": {
              "const": "update"
            },
            "candidateIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "targetId": {
              "$ref": "story-creation.schema.json#/definitions/Id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "sourceIds",
            "targetId",
            "name",
            "description"
          ],
          "properties": {
            "op": {
              "const": "merge"
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "$ref": "story-creation.schema.json#/definitions/Id"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "targetId": {
              "$ref": "story-creation.schema.json#/definitions/Id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "entityId"
          ],
          "properties": {
            "op": {
              "const": "delete"
            },
            "entityId": {
              "$ref": "story-creation.schema.json#/definitions/Id"
            }
          }
        }
      ]
    },
    "IntegrationReply": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "decisions": {
              "items": {
                "properties": {
                  "op": {
                    "enum": [
                      "create",
                      "update",
                      "merge",
                      "delete"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "required": [
        "decisions"
      ],
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EntityDecision"
          }
