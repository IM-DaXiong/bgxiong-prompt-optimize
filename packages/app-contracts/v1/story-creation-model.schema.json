{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story creation model input and output contract",
  "schemaVersion": 1,
  "definitions": {
    "ChapterDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "script",
        "sourceChapterId"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "sourceChapterId": {
          "anyOf": [
            {
              "$ref": "story-creation.schema.json#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "referenceImageIndices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    },
    "ChaptersReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapters"
      ],
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChapterDraft"
          },
          "minItems": 1
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "name",
        "description"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "EntityRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "existing"
            },
            "id": {
              "$ref": "story-creation.schema.json#/definitions/Id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "candidateId"
          ],
          "properties": {
            "kind": {
              "const": "candidate"
            },
            "candidateId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "Mentions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "props"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EntityRef"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EntityRef"
          }
        }
      }
    },
    "CandidateLists": {
      "type": "object",
      "additionalProperties": false,
