{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text-organize.schema.json",
  "title": "Text organize contract (constants + model output/review schemas)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "enabled",
    "aiTaskKind",
    "creatorToolId",
    "formats",
    "joiners",
    "presets",
    "defaults",
    "chunking",
    "coverageDispositions",
    "reviewSeverities",
    "phases",
    "errors",
    "errorLocaleKeys",
    "versionTitleKey"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contractId": {
      "const": "text-organize"
    },
    "enabled": {
      "type": "boolean"
    },
    "aiTaskKind": {
      "const": "text_organize"
    },
    "creatorToolId": {
      "const": "text.organize"
    },
    "formats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Format"
      },
      "uniqueItems": true
    },
    "joiners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentence_per_line",
        "paragraphs"
      ],
      "properties": {
        "sentence_per_line": {
          "const": "\n"
        },
        "paragraphs": {
          "const": "\n\n"
        }
      }
    },
    "presets": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "presetId",
          "labelKey",
          "templateKeys",
          "defaultFormat"
        ],
        "properties": {
          "presetId": {
            "$ref": "#/$defs/PresetId"
          },
          "labelKey": {
            "type": "string"
          },
          "templateKeys": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh-CN",
              "en"
            ],
            "properties": {
              "zh-CN": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "defaultFormat": {
            "$ref": "#/$defs/Format"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presetId"
      ],
      "properties": {
        "presetId": {
          "$ref": "#/$defs/PresetId"
        }
      }
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextSourceUnitsBefore",
        "contextSourceUnitsAfter",
        "outputSafetyRatio",
        "conservativeEstimateMarker"
      ],
      "properties": {
        "contextSourceUnitsBefore": {
          "type": "integer",
          "minimum": 0
        },
        "contextSourceUnitsAfter": {
          "type": "integer",
          "minimum": 0
        },
        "outputSafetyRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conservativeEstimateMarker": {
          "type": "string"
        }
      }
    },
    "coverageDispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Disposition"
      }
    },
    "reviewSeverities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Severity"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "enum": [
          "preparing",
          "generating",
          "reviewing",
          "completed",
          "failed",
          "cancelled"
        ]
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ErrorCode"
      },
      "uniqueItems": true
    },
    "errorLocaleKeys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ErrorCode"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "versionTitleKey": {
      "type": "string"
    }
  },
  "$defs": {
    "Format": {
      "enum": [
        "sentence_per_line",
        "paragraphs"
      ]
    },
    "PresetId": {
      "enum": [
        "voiceover",
        "episode",
        "storyboard",
        "prompt",
        "story"
      ]
    },
    "Disposition": {
      "enum": [
        "represented",
        "removed_filler"
      ]
    },
    "Severity": {
      "enum": [
        "pass",
        "minor",
        "blocking"
      ]
    },
    "ErrorCode": {
      "enum": [
        "featureDisabled",
        "noModel",
        "contextOverflow",
        "outputTruncated",
        "outputSchemaInvalid",
        "unknownId",
        "reviewBlocking",
        "vendorFailed",
        "authFailed",
        "taskWriteFailed",
        "cancelled",
        "surfaceBusy",
        "surfaceConflict",
        "emptySource",
        "promptConfigInvalid"
      ]
    },
    "UnitId": {
      "type": "string",
      "pattern": "^u[1-9][0-9]*$"
    },
    "SourceId": {
      "type": "string",
      "pattern": "^s[1-9][0-9]*$"
    },
    "ModelOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units"
      ],
      "properties": {
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sourceIds",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/UnitId"
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceId"
                },
                "uniqueItems": true
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "disposition",
              "unitIds"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/SourceId"
              },
              "disposition": {
                "$ref": "#/$defs/Disposition"
              },
              "unitIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/UnitId"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "ReviewOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "findings"
      ],
      "properties": {
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "ruleId",
              "sourceIds",
              "unitIds",
              "message"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "minor",
                  "blocking"
                ]
              },
              "ruleId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceId"
                }
              },
              "unitIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/UnitId"
                }
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
