{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hierarchy-outline-resource.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "storyId",
    "runId",
    "cursor",
    "itemIds"
  ],
  "properties": {
    "kind": {
      "const": "hierarchyOutline"
    },
    "storyId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "itemIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
