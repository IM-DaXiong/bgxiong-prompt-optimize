{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hierarchy-review-edit-v1.schema.json",
  "$ref": "#/definitions/ReviewEdit",
  "definitions": {
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "severity",
        "itemIds",
        "evidenceRefs",
        "explanation"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "x-closedSet": "ruleIds"
        },
        "severity": {
          "type": "string",
          "enum": [
            "minor",
            "blocking"
          ]
        },
        "itemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-closedSet": "itemIds"
          },
          "minItems": 0
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "hierarchy-continuity-v1.schema.json#/definitions/EvidenceRef"
          },
          "minItems": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "FinalCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "result",
        "evidenceRefs",
        "explanation"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "x-closedSet": "ruleIds"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "minor",
            "blocking",
            "not_applicable"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "hierarchy-continuity-v1.schema.json#/definitions/EvidenceRef"
          },
          "minItems": 0
        },
        "explanation": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "explanation": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ReviewChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "ruleIds",
        "description"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "x-closedSet": "itemIds"
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-closedSet": "ruleIds"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ReviewReplacement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "outline",
            "newItems"
          ],
          "properties": {
            "type": {
              "const": "structure"
            },
            "outline": {
              "$ref": "hierarchy-outline-v1.schema.json#/definitions/Outline"
            },
            "newItems": {
              "type": "array",
              "items": {
                "$ref": "hierarchy-outline-v1.schema.json#/definitions/ProposalItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "detail"
          ],
          "properties": {
            "type": {
              "const": "detail"
            },
            "detail": {
              "$ref": "hierarchy-detail-v1.schema.json#/definitions/Detail"
            }
          }
        }
      ]
    },
    "ReviewEdit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "inputDigest",
            "ruleSetDigest",
            "outlineRevision",
            "itemId",
            "inputFindings",
            "finalChecks"
          ],
          "properties": {
            "action": {
              "const": "keep"
            },
            "inputDigest": {
              "type": "string",
              "minLength": 1
            },
            "ruleSetDigest": {
              "type": "string",
              "minLength": 1
            },
            "outlineRevision": {
              "type": "integer",
              "minimum": 1
            },
            "itemId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "x-closedSet": "itemIds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputFindings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Finding"
              },
              "minItems": 0
            },
            "finalChecks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FinalCheck"
              },
              "minItems": 1
            }
          },
          "allOf": [
            {
              "properties": {
                "finalChecks": {
                  "items": {
                    "properties": {
                      "result": {
                        "enum": [
                          "pass",
                          "minor",
                          "not_applicable"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "replacement",
            "changes",
            "inputDigest",
            "ruleSetDigest",
            "outlineRevision",
            "itemId",
            "inputFindings",
            "finalChecks"
          ],
          "properties": {
            "action": {
              "const": "revise"
            },
            "replacement": {
              "$ref": "#/definitions/ReviewReplacement"
            },
            "changes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ReviewChange"
              },
              "minItems": 1
            },
            "inputDigest": {
              "type": "string",
              "minLength": 1
            },
            "ruleSetDigest": {
              "type": "string",
              "minLength": 1
            },
            "outlineRevision": {
              "type": "integer",
              "minimum": 1
            },
            "itemId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "x-closedSet": "itemIds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputFindings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Finding"
              },
              "minItems": 0
            },
            "finalChecks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FinalCheck"
              },
              "minItems": 1
            }
          },
          "allOf": [
            {
              "properties": {
                "inputFindings": {
                  "contains": {
                    "properties": {
                      "severity": {
                        "const": "blocking"
                      }
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "finalChecks": {
                  "items": {
                    "properties": {
                      "result": {
                        "enum": [
                          "pass",
                          "minor",
                          "not_applicable"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "inputDigest",
            "ruleSetDigest",
            "outlineRevision",
            "itemId",
            "inputFindings",
            "finalChecks"
          ],
          "properties": {
            "action": {
              "const": "needs_attention"
            },
            "inputDigest": {
              "type": "string",
              "minLength": 1
            },
            "ruleSetDigest": {
              "type": "string",
              "minLength": 1
            },
            "outlineRevision": {
              "type": "integer",
              "minimum": 1
            },
            "itemId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "x-closedSet": "itemIds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputFindings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Finding"
              },
              "minItems": 0
            },
            "finalChecks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FinalCheck"
              },
              "minItems": 1
            }
          },
          "allOf": [
            {
              "properties": {
                "finalChecks": {
                  "contains": {
                    "properties": {
                      "result": {
                        "const": "blocking"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
