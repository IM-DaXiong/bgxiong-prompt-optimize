{
  "list": {
    "type": "object",
    "additionalProperties": false,
    "required": ["storyId", "chapterId"],
    "properties": {
      "storyId": { "type": "string", "minLength": 1 },
      "chapterId": { "type": "string", "minLength": 1 },
      "roleNodeIds": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "cursor": { "type": "string" },
      "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 }
    }
  },
  "prepare": {
    "type": "object",
    "additionalProperties": false,
    "required": ["actions"],
    "properties": {
      "actions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionId", "type", "storyId", "chapterId", "roleNodeId", "expectedRevision", "versionId", "imageId"],
              "properties": {
                "actionId": { "type": "string", "minLength": 1 },
                "type": { "const": "select" },
                "storyId": { "type": "string", "minLength": 1 },
                "chapterId": { "type": "string", "minLength": 1 },
                "roleNodeId": { "type": "string", "minLength": 1 },
                "expectedRevision": { "type": "integer", "minimum": 0 },
                "versionId": { "type": "string", "minLength": 1 },
                "imageId": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionId", "type", "storyId", "chapterId", "roleNodeId", "expectedRevision"],
              "properties": {
                "actionId": { "type": "string", "minLength": 1 },
                "type": { "const": "reset" },
                "storyId": { "type": "string", "minLength": 1 },
                "chapterId": { "type": "string", "minLength": 1 },
                "roleNodeId": { "type": "string", "minLength": 1 },
                "expectedRevision": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        }
      }
    }
  }
}
