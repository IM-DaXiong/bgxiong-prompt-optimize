{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creator-settings-actions.schema.json",
  "title": "CreatorSettingsActions",
  "description": "W5 Batch3: settings.change.prepare payload. Applied by change.apply (plan kind settings.change) with AppSettingsWrite enforced via KernelHostPort.",
  "type": "object",
  "required": [
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "Non-secret field write (CAS on value revision). Secret paths rejected.",
            "required": [
              "type",
              "actionId",
              "fieldPath",
              "value",
              "expectedRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "settings.field.patch"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "fieldPath": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "expectedRevision": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "description": "Write-only secret (credentials.<id>.apiKey|accessKeyId|secretAccessKey); result is redacted status only (§0.1).",
            "required": [
              "type",
              "actionId",
              "fieldPath",
              "secretValue"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "settings.secret.write"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "fieldPath": {
                "type": "string",
                "minLength": 1
              },
              "secretValue": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "description": "Clear a secret; result is redacted status only.",
            "required": [
              "type",
              "actionId",
              "fieldPath"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "settings.secret.clear"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "fieldPath": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "description": "Settings-page category default: defaults.<kind> = {bindingId, modelId}. NOT the UI ModelPicker last-pick preference (kept separate).",
            "required": [
              "type",
              "actionId",
              "pickerKind",
              "pick"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "settings.modelPick.set"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "pickerKind": {
                "enum": [
                  "text",
                  "image",
                  "imageToImage",
                  "video",
                  "keyframe",
                  "tts",
                  "speech"
                ]
              },
              "pick": {
                "type": "object",
                "required": [
                  "bindingId",
                  "modelId"
                ],
                "additionalProperties": false,
                "properties": {
                  "bindingId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "modelId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "Shallow merge into extensions.preferences.layoutPrefs (= ui mergePreferencesPartial layoutPrefs); CAS on the whole layoutPrefs object.",
            "required": [
              "type",
              "actionId",
              "patch",
              "expectedRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "settings.layout.patch"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "minProperties": 1
              },
              "expectedRevision": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "description": "W5 Batch4: IPC import_prompt_profile_dir core (parse_package_from_dir + install_package_atomic). AppSettingsWrite. Compensation restores {app_data}/prompt_profiles/<id>/<version> snapshot.",
            "required": [
              "type",
              "actionId",
              "directoryPath"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "settings.promptProfile.import"
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "directoryPath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "bindingValidateArgs": {
      "description": "settings.binding.validate (read tool) arguments; twin of IPC validate_setting_binding (no entitlement gate). Result = redacted BindingHealthItem.",
      "type": "object",
      "required": [
        "bindingId"
      ],
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accountAdminArgs": {
      "description": "settings.account.preview, resolve and commit arguments. Secrets stay in draft and are not returned.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "op": { "type": "string" },
        "credentialId": { "type": "string" },
        "targetCredentialId": { "type": "string" },
        "expectedRevision": { "type": "string" },
        "confirmed": { "type": "boolean" },
        "draft": { "type": "object" }
      }
    }
  }
}
