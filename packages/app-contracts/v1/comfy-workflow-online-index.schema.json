{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComfyUI official workflow online catalog payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "sequence",
    "publishedAt",
    "packages",
    "filters",
    "guidance",
    "retired"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channel": {
      "const": "comfy-workflow"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendors",
        "functions"
      ],
      "properties": {
        "vendors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vendor"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function"
          }
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages"
      ],
      "properties": {
        "messages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpointUnconfigured",
            "endpointUnavailable",
            "missingModels"
          ],
          "properties": {
            "endpointUnconfigured": {
              "$ref": "#/$defs/messageLocales"
            },
            "endpointUnavailable": {
              "$ref": "#/$defs/messageLocales"
            },
            "missingModels": {
              "$ref": "#/$defs/messageLocales"
            }
          }
        }
      }
    },
    "retired": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retired"
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en"
      ],
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labels",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "uniqueItems": true
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labels",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "actionLabel"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "actionLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      }
    },
    "messageLocales": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en"
      ],
      "properties": {
        "zh-CN": {
          "$ref": "#/$defs/message"
        },
        "en": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceSha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "displayName",
        "newInstall",
        "hostVersionRange",
        "upgradeFrom",
        "file",
        "bytes",
        "sha256",
        "vendorId",
        "functionIds"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "newInstall": {
          "type": "boolean"
        },
        "hostVersionRange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "upgradeFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceVersion"
          },
          "uniqueItems": true
        },
        "adoptSources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 238
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "vendorId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "functionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "retired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "retiredAt"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "retiredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
