          "kind": "canvasNode",
          "projectId": "project_example",
          "nodeId": "node_example"
        },
        "fields": [
          {
            "fieldId": "modelPick",
            "valueSchemaRef": "creator-canvas-actions.schema.json#node.modelPick.set",
            "persistence": "durable",
