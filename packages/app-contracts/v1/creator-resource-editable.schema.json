{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creator-resource-editable.schema.json",
  "title": "CreatorResourceEditableV1",
  "description": "Field descriptors for resource.editable.get. Nullable and required come only from this schema. A non-editable field has null writeToolId and null actionType. Values must not include secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
