          ]
        },
        "userHint": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "revisionToken": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "writeToolId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "actionType": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "targetField": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "scopeRef": {
          "oneOf": [
            {
              "$ref": "creator-resource-ref.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "enum": [
                  "readOnly",
                  "unavailable"
                ]
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "writeToolId": {
                "type": "null"
              },
              "actionType": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "valid": true,
      "value": {
        "schemaVersion": 1,
