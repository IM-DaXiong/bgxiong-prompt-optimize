{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creator-host-grants-v1.schema.json",
  "title": "Creator Host grants (writeScope / modelBudget) v1",
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$" },
    "kind": { "type": "string", "enum": ["writeScope", "modelBudget"] },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "kind", "targetClosure", "createdAt", "expiresAt"],
      "properties": {
        "requestId": { "$ref": "#/definitions/id" },
        "kind": { "$ref": "#/definitions/kind" },
        "targetClosure": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/id" } },
        "requestedMaxHops": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "createdAt": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "minLength": 1 }
      }
    },
    "approveInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId"],
      "properties": {
        "requestId": { "$ref": "#/definitions/id" },
        "approvedMaxHops": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "revokeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantId"],
      "properties": { "grantId": { "$ref": "#/definitions/id" } }
    }
  }
}