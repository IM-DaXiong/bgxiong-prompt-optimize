{
  "$schema": "./audio-recording.schema.json",
  "contractId": "audio-recording",
  "enabled": true,
  "commands": [
    "audio_recording_probe",
    "audio_recording_start",
    "audio_recording_append",
    "audio_recording_stop",
    "audio_recording_status",
    "audio_recording_recover",
    "audio_recording_discard",
    "audio_recording_list_interrupted"
  ],
  "sessionStates": ["ready", "recording", "finalizing", "saved", "interrupted", "failed", "discarded"],
  "outputFormats": ["wav", "mp3", "flac"],
  "defaults": {
    "format": "wav",
    "sampleRateHz": 48000,
    "channels": 1,
    "pcmBitDepth": 16,
    "mp3BitrateKbps": 192
  },
  "allowedSampleRatesHz": [44100, 48000],
  "allowedMp3BitratesKbps": [128, 192, 320],
  "transport": {
    "maxChunkPayloadBytes": 65536,
    "maxPendingPcmBytes": 2097152,
    "maxInFlightInvokes": 1,
    "maxJsonRequestBytes": 131072,
    "appendTimeoutMs": 10000,
    "checkpointInputSeconds": 2,
    "bytesPerSample": 4
  },
  "disk": {
    "minFreeBytesReserve": 268435456,
    "sessionsDirName": "audio_recording"
  },
  "preferencesKey": "bgxiong.audioRecording.outputPreferences",
  "devicePreferenceKey": "bgxiong.micCapture.devicePreference",
  "errors": [
    "featureDisabled",
    "runtimeMissing",
    "encoderMissing",
    "sessionBusy",
    "sessionNotFound",
    "ownerMismatch",
    "invalidFormat",
    "invalidSequence",
    "invalidSampleRate",
    "invalidChunk",
    "queueFull",
    "diskFull",
    "ioError",
    "encodeFailed",
    "importFailed",
    "casConflict",
    "targetGone",
    "cancelled",
    "probeFailed",
    "notRecoverable",
    "busy"
  ],
  "errorLocaleKeys": {
    "featureDisabled": "audioRecording.err.featureDisabled",
    "runtimeMissing": "audioRecording.err.runtimeMissing",
    "encoderMissing": "audioRecording.err.encoderMissing",
    "sessionBusy": "audioRecording.err.sessionBusy",
    "sessionNotFound": "audioRecording.err.sessionNotFound",
    "ownerMismatch": "audioRecording.err.ownerMismatch",
    "invalidFormat": "audioRecording.err.invalidFormat",
    "invalidSequence": "audioRecording.err.invalidSequence",
    "invalidSampleRate": "audioRecording.err.invalidSampleRate",
    "invalidChunk": "audioRecording.err.invalidChunk",
    "queueFull": "audioRecording.err.queueFull",
    "diskFull": "audioRecording.err.diskFull",
    "ioError": "audioRecording.err.ioError",
    "encodeFailed": "audioRecording.err.encodeFailed",
    "importFailed": "audioRecording.err.importFailed",
    "casConflict": "audioRecording.err.casConflict",
    "targetGone": "audioRecording.err.targetGone",
    "cancelled": "audioRecording.err.cancelled",
    "probeFailed": "audioRecording.err.probeFailed",
    "notRecoverable": "audioRecording.err.notRecoverable",
    "busy": "audioRecording.err.busy"
  }
}
