{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["wavPaths", "mediaPaths"],
  "properties": {
    "wavPaths": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "mediaPaths": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "referenceIndex": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
