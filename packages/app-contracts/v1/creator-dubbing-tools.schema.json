{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creator-dubbing-tools.schema.json",
  "title": "Automatic dubbing shared UI/F1/MCP contract",
  "definitions": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceRelativePath": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "sourceLanguage": {
          "type": "string",
          "minLength": 1
        },
        "targetLanguage": {
          "type": "string",
          "minLength": 1
        },
        "speakerMode": {
          "enum": [
            "single",
            "multiple"
          ]
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "minimum": 0
              },
              "speakerId": {
                "type": "string",
                "minLength": 1
              },
              "sourceText": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "locked": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "startMs",
              "endMs",
              "speakerId",
              "sourceText",
              "text",
              "locked"
            ]
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "configuration": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {},
                    "required": []
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pickKey": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "draft": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "mode": {
                            "enum": [
                              "plain",
                              "voice_design",
                              "reference_clone"
                            ]
                          },
                          "controlPrompt": {
                            "type": "string"
                          },
                          "promptText": {
                            "type": "string"
                          },
                          "styleControl": {
                            "type": "string"
                          },
                          "referenceMeta": {
                            "anyOf": [
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "audioRelativePath": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "durationSeconds": {
                                    "type": "number"
                                  },
                                  "format": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "audioRelativePath"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "emotionControl": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "mode"
                            ],
                            "properties": {
                              "mode": {
                                "type": "string",
                                "enum": [
                                  "none",
                                  "inherit_speaker",
                                  "text",
                                  "audio_reference",
                                  "vector"
                                ]
                              },
                              "text": {
                                "type": "string"
                              },
                              "audioRelativePath": {
                                "type": "string"
                              },
                              "vector": {
                                "type": "array",
                                "items": {
                                  "type": "number"
                                }
                              },
                              "alpha": {
                                "type": "number"
                              },
                              "useRandom": {
                                "type": "boolean"
                              },
                              "intervalSilenceMs": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "maxTextTokensPerSegment": {
                                "type": "integer",
                                "minimum": 1
                              }
                            }
                          },
                          "speedHint": {
                            "enum": [
                              "slow",
                              "normal",
                              "fast"
                            ]
                          },
                          "speechRate": {
                            "type": "number"
                          },
                          "language": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "voiceId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "mode",
                          "controlPrompt",
                          "promptText",
                          "styleControl",
                          "emotionControl",
                          "speedHint",
                          "language",
                          "text"
                        ]
                      },
                      "voiceCommit": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "voiceSource": {
                            "enum": [
                              "preset",
                              "custom"
                            ]
                          },
                          "highlightProfileId": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "enrolledProfileId": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "enrolledProviderKind": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "voiceSource"
                        ]
                      }
                    },
                    "required": [
                      "draft",
                      "voiceCommit"
                    ]
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "configuration"
            ]
          }
        },
        "sourceAudioTrack": {
          "type": "integer",
          "minimum": 0
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "target"
            ]
          }
        }
      },
      "required": [
        "id",
        "revision",
        "title",
        "sourceRelativePath",
        "durationMs",
        "sourceLanguage",
        "targetLanguage",
        "speakerMode",
        "cues",
        "roles"
      ]
    },
    "dubbing.project.list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "dubbing.project.read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "projectId"
      ]
    },
    "dubbing.change.prepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "project.create",
                  "project.replace",
                  "project.delete"
                ]
              },
              "project": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceRelativePath": {
                    "type": "string",
                    "minLength": 1
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sourceLanguage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetLanguage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "speakerMode": {
                    "enum": [
                      "single",
                      "multiple"
                    ]
                  },
                  "cues": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "startMs": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "endMs": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "speakerId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sourceText": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "locked": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "startMs",
                        "endMs",
                        "speakerId",
                        "sourceText",
                        "text",
                        "locked"
                      ]
                    }
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "configuration": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {},
                              "required": []
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "pickKey": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "draft": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "mode": {
                                      "enum": [
                                        "plain",
                                        "voice_design",
                                        "reference_clone"
                                      ]
                                    },
                                    "controlPrompt": {
                                      "type": "string"
                                    },
                                    "promptText": {
                                      "type": "string"
                                    },
                                    "styleControl": {
                                      "type": "string"
                                    },
                                    "referenceMeta": {
                                      "anyOf": [
                                        {
                                          "type": "object",
                                          "additionalProperties": false,
                                          "properties": {
                                            "audioRelativePath": {
                                              "type": "string",
                                              "minLength": 1
                                            },
                                            "durationSeconds": {
                                              "type": "number"
                                            },
                                            "format": {
                                              "type": "string"
                                            }
                                          },
                                          "required": [
                                            "audioRelativePath"
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "emotionControl": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": [
                                        "mode"
                                      ],
                                      "properties": {
                                        "mode": {
                                          "type": "string",
                                          "enum": [
                                            "none",
                                            "inherit_speaker",
                                            "text",
                                            "audio_reference",
                                            "vector"
                                          ]
                                        },
                                        "text": {
                                          "type": "string"
                                        },
                                        "audioRelativePath": {
                                          "type": "string"
                                        },
                                        "vector": {
                                          "type": "array",
                                          "items": {
                                            "type": "number"
                                          }
                                        },
                                        "alpha": {
                                          "type": "number"
                                        },
                                        "useRandom": {
                                          "type": "boolean"
                                        },
                                        "intervalSilenceMs": {
                                          "type": "integer",
                                          "minimum": 0
                                        },
                                        "maxTextTokensPerSegment": {
                                          "type": "integer",
                                          "minimum": 1
                                        }
                                      }
                                    },
                                    "speedHint": {
                                      "enum": [
                                        "slow",
                                        "normal",
                                        "fast"
                                      ]
                                    },
                                    "speechRate": {
                                      "type": "number"
                                    },
                                    "language": {
                                      "type": "string"
                                    },
                                    "text": {
                                      "type": "string"
                                    },
                                    "voiceId": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "mode",
                                    "controlPrompt",
                                    "promptText",
                                    "styleControl",
                                    "emotionControl",
                                    "speedHint",
                                    "language",
                                    "text"
                                  ]
                                },
                                "voiceCommit": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "voiceSource": {
                                      "enum": [
                                        "preset",
                                        "custom"
                                      ]
                                    },
                                    "highlightProfileId": {
                                      "anyOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "enrolledProfileId": {
                                      "anyOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "enrolledProviderKind": {
                                      "anyOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "voiceSource"
                                  ]
                                }
                              },
                              "required": [
                                "draft",
                                "voiceCommit"
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "configuration"
                      ]
                    }
                  },
                  "sourceAudioTrack": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "glossary": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "source": {
                          "type": "string",
                          "minLength": 1
                        },
                        "target": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "source",
                        "target"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "revision",
                  "title",
                  "sourceRelativePath",
                  "durationMs",
                  "sourceLanguage",
                  "targetLanguage",
                  "speakerMode",
                  "cues",
                  "roles"
                ]
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 0
              },
              "projectId": {
                "type": "string",
                "minLength": 1
              },
              "confirm": {
                "const": true
              }
            },
            "required": [
              "type",
              "expectedRevision"
            ],
            "if": { "properties": { "type": { "const": "project.delete" } } },
            "then": {
              "required": ["projectId", "confirm"],
              "properties": { "expectedRevision": { "minimum": 1 } },
              "not": { "required": ["project"] }
            },
            "else": {
              "required": ["project"],
              "properties": { "projectId": false, "confirm": false }
            }
          }
        }
      },
      "required": [
        "actions"
      ]
    },
    "dubbing.subtitle.inspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceText": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "offsetMs": {
          "type": "integer"
        }
      },
      "required": [
        "sourceText",
        "durationMs"
      ]
    },
    "dubbing.media.import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRef": {
          "$ref": "creator-local-source-v1.schema.json#/definitions/sourceRef"
        }
      },
      "required": [
        "sourceRef"
      ]
    },
    "dubbing.synthesize.submit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "cueIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "projectId",
        "expectedRevision"
      ]
    },
    "dubbing.export.submit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "container": {
          "type": "string",
          "enum": [
            "mp4",
            "mkv",
            "mov"
          ]
        },
        "exportOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "external",
                    "separate"
                  ]
                },
                "sourceRelativePath": {
                  "type": "string",
                  "minLength": 1
                },
                "gainDb": {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 12
                },
                "modelId": {
                  "type": "string",
                  "enum": [
                    "model_bs_roformer_viperx_1297",
                    "model_melband_kim_vocals",
                    "model_htdemucs_ft"
                  ]
                }
              },
              "required": [
                "mode",
                "gainDb"
              ]
            },
            "subtitleMode": {
              "type": "string",
              "enum": [
                "sidecar",
                "soft"
              ]
            }
          }
        }
      },
      "required": [
        "projectId",
        "expectedRevision"
      ]
    },
    "dubbing.analyze.submit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "selection": {
          "$ref": "asr.schema.json#/definitions/selectionV1"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "speakerDetection": {
          "type": "string",
          "enum": [
            "auto",
            "existing"
          ]
        },
        "speakerCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "projectId",
        "expectedRevision",
        "selection"
      ]
    },
    "dubbing.translate.submit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "retryUncertain": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "expectedRevision"
      ]
    },
    "dubbing.transcript.import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "sourceFingerprint": {
              "type": "string",
              "minLength": 1
            },
            "durationMs": {
              "type": "integer",
              "minimum": 1
            },
            "timeOrigin": {
              "const": "sourceMedia"
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "startMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "endMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "speakerId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "startMs",
                  "endMs",
                  "text"
                ]
              }
            },
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "schemaVersion",
            "sourceFingerprint",
            "durationMs",
            "timeOrigin",
            "segments"
          ]
        },
        "targetScript": {
          "type": "boolean"
        },
        "speakerDetection": {
          "type": "string",
          "enum": [
            "auto",
            "existing"
          ]
        },
        "speakerCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "projectId",
        "expectedRevision",
        "snapshot"
      ]
    },
    "dubbing.workflow.submit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "transcriptMode": {
          "type": "string",
          "enum": [
            "existingSource",
            "existingTarget",
            "transcribe"
          ]
        },
        "asrSelection": {
          "$ref": "asr.schema.json#/definitions/selectionV1"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "enum": [
            "mp4",
            "mkv",
            "mov"
          ]
        },
        "defaultRoleId": {
          "type": "string",
          "minLength": 1
        },
        "speakerDetection": {
          "type": "string",
          "enum": [
            "auto",
            "existing"
          ]
        },
        "speakerCount": {
          "type": "integer",
          "minimum": 1
        },
        "exportOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "external",
                    "separate"
                  ]
                },
                "sourceRelativePath": {
                  "type": "string",
                  "minLength": 1
                },
