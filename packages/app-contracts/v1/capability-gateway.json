{
  "schemaVersion": 1,
  "identity": "capability-gateway",
  "apiVersion": "1.0.0",
  "listenHost": "127.0.0.1",
  "listenHostLan": "0.0.0.0",
  "listenPort": 18500,
  "tokenFileName": "capability_gateway_control.json",
  "discoveryRelDir": "capability-gateway",
  "discoveryFileName": "registry.json",
  "maxUploadBytes": 104857600,
  "maxUploadItems": 8,
  "jobTtlHours": 72,
  "maxConcurrentJobs": 2,
  "reservedPorts": [8001, 8188, 18201, 18202, 18210, 18380, 18450],
  "reservedPortRanges": [[18080, 18089], [18100, 18199]],
  "errorCodes": [
    "CAP_GW_BAD_REQUEST",
    "CAP_GW_UNKNOWN_CAPABILITY",
    "CAP_GW_UNAVAILABLE",
    "CAP_GW_AUTHZ",
    "CAP_GW_QUOTA",
    "CAP_GW_MODEL_UNAVAILABLE",
    "CAP_GW_JOB_NOT_FOUND",
    "CAP_GW_EXEC",
    "CAP_GW_TIMEOUT",
    "CAP_GW_IDEMPOTENCY_CONFLICT",
    "CAP_GW_CANCEL_TERMINAL",
    "CAP_GW_CONTRACT_MISMATCH",
    "CAP_GW_PATH_DENIED",
    "CAP_GW_SCHEMA_INVALID",
    "CAP_GW_BUSY",
    "CAP_GW_LAN_POLICY"
  ]
}
