{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewable motion-card candidates; empty is valid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceVersion",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "reason",
          "templateRef",
          "layoutId",
          "props"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "layoutId": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "precedingContext": {
            "type": "string"
          },
          "followingContext": {
            "type": "string"
          },
          "props": {
            "type": "object"
          },
          "templateRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "templateId",
              "version"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "templateId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
