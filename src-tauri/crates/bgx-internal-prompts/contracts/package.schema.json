{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bgx-internal-prompts/package.schema.json",
  "title": "InternalPromptPackage",
  "oneOf": [
    { "$ref": "#/$defs/requestPackage" },
    { "$ref": "#/$defs/materialPackage" }
  ],
  "$defs": {
    "requestPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "task", "kind", "messages"],
      "properties": {
        "formatVersion": { "const": 2 },
        "task": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "const": "request" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "materialPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "task", "kind", "materials"],
      "properties": {
        "formatVersion": { "const": 2 },
        "task": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "const": "material" },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/material" }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "parts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "role": { "enum": ["system", "user", "assistant"] },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/part" }
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "parts"],
      "properties": {
        "slot": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/part" }
        }
      }
    },
    "part": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileByLanguage"],
          "properties": {
            "fileByLanguage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["zh", "en"],
              "properties": {
                "zh": { "type": "string", "minLength": 1 },
                "en": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "encoding"],
          "properties": {
            "input": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
            "encoding": { "enum": ["json", "text"] }
          }
        }
      ]
    }
  }
}
