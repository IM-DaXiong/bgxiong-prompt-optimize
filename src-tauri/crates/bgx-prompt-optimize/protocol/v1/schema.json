{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bgxiong Prompt Optimize stdio protocol v1 frame",
  "description": "The v field versions the prompt optimization JSON Lines protocol. The Bgxiong Vendor Adapter SDK uses its own invocation protocolVersion field.",
  "oneOf": [
    {
      "$ref": "#/$defs/targets_list"
    },
    {
      "$ref": "#/$defs/skills_check"
    },
    {
      "$ref": "#/$defs/skills_install"
    },
    {
      "$ref": "#/$defs/optimize"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/textRequest"
    },
    {
      "$ref": "#/$defs/done"
    },
    {
      "$ref": "#/$defs/failed"
    },
    {
      "$ref": "#/$defs/textReply"
    },
    {
      "$ref": "#/$defs/textFailure"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "stepLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "optimArgs": {
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePrompt": {
          "type": "string",
          "pattern": "\\S"
        },
        "textMode": {
          "enum": [
            "configured",
            "callback"
          ]
        },
        "expectedMethodDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "targetId",
        "sourcePrompt"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "literary",
            "video"
          ]
        },
        "availability": {
          "enum": [
            "ready",
            "installable",
            "unavailable"
          ]
        },
        "methodId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "profileId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "profileVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "inputModes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "methodDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "targetId",
        "label",
        "kind",
        "availability"
      ],
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "candidateId",
        "packageId",
        "version",
        "sha256",
        "sourceSha256"
      ],
      "additionalProperties": true
    },
    "receipt": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "methodId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "methodDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "coreVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requestId",
        "targetId",
        "methodId",
        "methodDigest",
        "coreVersion"
      ],
      "additionalProperties": true
    },
    "call": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "content": {}
            },
            "required": [
              "role",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "jsonMode": {
          "type": "boolean"
        },
        "schema": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "stepLabel": {
          "type": "string",
          "minLength": 1
        },
        "imageCountPolicy": {
          "enum": [
            "modelCapability",
            "asSubmitted"
          ]
        }
      },
      "required": [
        "messages",
        "jsonMode",
        "schema",
        "stepLabel",
        "imageCountPolicy"
      ],
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "finishReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rawJson": {}
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "targets_list": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "targets.list"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "op"
      ],
      "additionalProperties": false
    },
    "skills_check": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "skills.check"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "op"
      ],
      "additionalProperties": false
    },
    "skills_install": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "skills.install"
        },
        "args": {
          "type": "object",
          "properties": {
            "candidateId": {
              "type": "string",
              "minLength": 1
            },
            "confirmedNewInstall": {
              "type": "boolean"
            }
          },
          "required": [
            "candidateId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    "optimize": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "optimize"
        },
        "args": {
          "$ref": "#/$defs/optimArgs"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "cancel"
        },
        "args": {
          "type": "object",
          "properties": {
            "requestId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "requestId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    "textRequest": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "const": "text.request"
        },
        "callId": {
          "$ref": "#/$defs/id"
        },
        "call": {
          "$ref": "#/$defs/call"
        }
      },
      "required": [
        "v",
        "id",
        "event",
        "callId",
        "call"
      ],
      "additionalProperties": true
    },
    "done": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "const": "done"
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "targets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/target"
                  }
                }
              },
              "required": [
                "targets"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "candidates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/candidate"
                  }
                }
              },
              "required": [
                "candidates"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "packageId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "packageDigest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "required": [
                "packageId",
                "version",
                "packageDigest"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "optimizedPrompt": {
                  "type": "string",
                  "minLength": 1
                },
                "receipt": {
                  "$ref": "#/$defs/receipt"
                }
              },
              "required": [
                "optimizedPrompt",
                "receipt"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "cancelRequestedFor": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "cancelRequestedFor"
              ],
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "v",
        "id",
        "event",
        "result"
      ],
      "additionalProperties": true
    },
    "failed": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "event": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "v",
        "id",
        "event",
        "error"
      ],
      "additionalProperties": true
    },
    "textReply": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "text.reply"
        },
        "callId": {
          "$ref": "#/$defs/id"
        },
        "reply": {
          "$ref": "#/$defs/reply"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "callId",
        "reply"
      ],
      "additionalProperties": false
    },
    "textFailure": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "text.reply"
        },
        "callId": {
          "$ref": "#/$defs/id"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "callId",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "not": {
    "required": [
      "op",
      "event"
    ]
  }
}
